{
  "name": "@abran-labs/onboard-kit",
  "version": "0.3.6",
  "description": "Drop-in onboarding flows for CLI tools. Pick your nodes, choose the order — the look is handled.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Abran Labs <abran.labs@gmail.com>",
  "homepage": "https://github.com/abran-labs/onboard-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abran-labs/onboard-kit.git"
  },
  "bugs": {
    "url": "https://github.com/abran-labs/onboard-kit/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "onboard-kit": "bin/onboard-kit.mjs"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:clean && bun run build:emit",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "demo": "bun run bin/onboard-kit.mjs demo",
    "prepack": "bun run build",
    "build:clean": "rm -rf dist",
    "build:emit": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "onboarding",
    "cli",
    "tui",
    "prompts",
    "clack",
    "setup",
    "wizard",
    "first-run",
    "typescript"
  ]
}
